    },
    {
      "id": "claim_d31d28cb5a28419e832e6963e118bfbe",
      "statement": "After callers authenticate grants, the kernel evaluates grant bodies in a fixed order: they must bind the intent, domain and policy, be valid at `issued_at <= now < expires_at`, match exact or bounded scope, use an allowed role, and satisfy optional proposer exclusion; only distinct passing credential IDs count, while failing or duplicate bodies add reasons and enough other passing bodies can still Allow.",
      "evidence": [
        {
          "resource": "repo://crates/policy-kernel/src/lib.rs#L419-L491",
          "version": "repo-lines-v1:sha256:8a97f2e5e3492f03286d47be96e167029bc2312b031c7579a56bf92e0b1724a5:"
        }
      ]
    },
    {
      "id": "claim_a679099930d745b98124c1341cfcba8f",
      "statement": "Policy and destination commitments exclude their administrative signatures and preview commitments bind candidate revision plus decoded operation and evidence hashes.",
      "evidence": [
        {
          "resource": "repo://crates/policy-kernel/src/hashing.rs#L9-L116",
          "version": "repo-lines-v1:sha256:5f6e70860a3cacfffacf1f245b5738c3f05311052c57635d790d2dff5335b337:"
        }
