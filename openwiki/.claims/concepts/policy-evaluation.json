    },
    {
      "id": "claim_abc1d8ed932d4e2b96d15ef9161a2994",
      "statement": "Grant authentication is outside `evaluate`: `verify_grants` rejects oversized or partially invalid sets after checking enrolled credentials, roles, validity, scheme and signatures, and prevents different credentials belonging to one person from satisfying a multi-person quorum.",
