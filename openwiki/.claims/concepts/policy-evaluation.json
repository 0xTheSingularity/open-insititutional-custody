    {
      "id": "claim_fdfac3524bd54887822d474a65de824f",
      "statement": "`evaluate` is a pure, deterministic, fail-closed decision function over caller-supplied inputs: it checks binding, then hard denials, selects the first matching rule, enforces that rule, and finally returns Allow or RequireApprovals from approval evaluation; any earlier failure returns Deny.",
      "evidence": [
        {
          "resource": "repo://crates/policy-kernel/src/lib.rs#L1-L16",
          "version": "repo-lines-v1:sha256:db6fb7deb2199aa64a7aecadff4537584a8040fddf5835823fd3c6690051cc41:"
        },
        {
          "resource": "repo://crates/policy-kernel/src/lib.rs#L160-L179",
          "version": "repo-lines-v1:sha256:06da905cc372bc6ed78a815a4101dd4a77343f47b153dc0de696ef5361f77976:"
        }
      ]
    },
    {
      "id": "claim_cfbadcfdff994e6fbe32df3dff77ef82",
      "statement": "Hard denials precede rules, enforce decoded intent and registered asset/destination meaning, and reject future/stale or insufficiently trusted evidence and more than 64 grants.",
      "evidence": [
        {
          "resource": "repo://crates/policy-kernel/src/lib.rs#L225-L320",
          "version": "repo-lines-v1:sha256:abd0fce9284ab4cf26afae203a81e3915bc2eeadf9a49131320784b5b04640d1:"
        }
      ]
    },
    {
      "id": "claim_5d6e9c6c12b749f3b99f46650878419b",
      "statement": "Rules select the first matching ordered scope, empty lists match all, and match_rule alone performs no binding, limit or approval enforcement.",
      "evidence": [
        {
          "resource": "repo://crates/policy-kernel/src/lib.rs#L322-L355",
          "version": "repo-lines-v1:sha256:b7f8b85eeafafbf2cf5a6ba8ee5e01f6aece0096ea81280bfe2a23fe44e22fc7:"
        }
      ]
    },
    {
      "id": "claim_4ebc0639e4a4469d8354144aae1e9460",
      "statement": "Rolling checks charge max(decoded amount, claimed outflows), require the exact exposure window, fail on overflow and permit equality at limits; operating windows are half-open and can wrap midnight.",
      "evidence": [
        {
          "resource": "repo://crates/policy-kernel/src/lib.rs#L357-L417",
          "version": "repo-lines-v1:sha256:3f1fc5a2cf41eb15fb30bddc7cf97fb5ac2c8c314792c4d42099699511feb192:"
        }
